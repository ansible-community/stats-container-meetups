# Meetup-to-Discourse Sync Configuration
# Copy to config.yml and fill in your values.

meetup:
  # OAuth2 JWT authentication (https://www.meetup.com/graphql/authentication/)
  client_key: "your_oauth_client_key"
  signing_key_id: "your_signing_key_id"
  private_key_path: "/config/meetup_private_key.pem"
  member_id: "123456789"
  pro_network: "ansible"
  api_url: "https://api.meetup.com/gql-ext"
  token_url: "https://secure.meetup.com/oauth2/access"

discourse:
  url: "https://forum.ansible.com"
  category_staging: 42       # Sandbox category ID (staging mode)
  category_production: 5     # Production category ID (--production mode)
  api_key: "your_discourse_api_key"
  api_user: "MeetupBot"

events:
  lookahead_days: 90
  lookback_days: 1
  # Preferred group for virtual/shared events (deduplication)
  virtual_group: "ansible-virtual-meetups"

